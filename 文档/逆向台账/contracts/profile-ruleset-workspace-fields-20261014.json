  "profile_fields": [
    {
      "field": "id/name/description/createdAt/updatedAt",
      "behavior": "string"
    },
    {
      "field": "schemaVersion",
      "behavior": "1"
    },
    {
      "field": "source",
      "behavior": "system | user; system 必须 readonly"
    },
    {
      "field": "readonly",
      "behavior": "boolean"
    },
    {
      "field": "enabledEntityTypeIds",
      "behavior": "非空去重，19默认类别 + schema允许signature；当前读写TI会删除signature"
    },
    {
      "field": "certNoPreferenceRecorded",
      "behavior": "可选boolean；迁移case_number带上cert_no，保存true"
    },
    {
      "field": "pseudonymTypeActions",
      "behavior": "entityType -> mask | pseudonym | partial_star | full_star"
    },
    {
      "field": "pseudonymTemplate.kind",
      "behavior": "schema standard | party_slots；当前PI强制standard"
    },
    {
      "field": "pseudonymTemplate.slots",
      "behavior": "party_slots>=2；id/label非空，id唯一；当前废弃"
    },
    {
      "field": "docx.defaultMode / markdown.defaultMode",
      "behavior": "default_star | full_star | default_pseudonym | custom_pseudonym | selective_pseudonym；旧default_pseudonym迁为custom_pseudonym"
    },
    {
      "field": "docx.removeHeaderFooter/removeImages/exportMarkdown",
      "behavior": "boolean"
    },
    {
      "field": "docx.commentHandlingMode",
      "behavior": "remove | anonymize | keep"
    },
    {
      "field": "pdf.defaultMode / image.defaultMode",
      "behavior": "default_star | default_pseudonym | custom_pseudonym | selective_pseudonym；没有full_star"
    },
    {
      "field": "pdf.maskStyle / image.maskStyle",
      "behavior": "black | white | purple | lightGray"
    },
    {
      "field": "pdf.exportPdfAsDocx/exportMarkdown；image.exportMarkdown",
      "behavior": "boolean"
    },
    {
      "field": "batch.docxDefaultMode/markdownDefaultMode",
      "behavior": "同文字mode；缺markdown迁default_star"
    },
    {
      "field": "batch.pdfDefaultMode/imageDefaultMode",
      "behavior": "同视觉mode"
    },
    {
      "field": "batch.exportMarkdownByKind",
      "behavior": "docx/pdf/image -> boolean"
    },
    {
      "field": "batch.pseudonymTableNameTemplates",
      "behavior": "singleDocument/unifiedBatch/independentBatch非空string"
    },
    {
      "field": "preferences",
      "behavior": "schemaVersion1/defaultProfileId/lastSuccessfulExportByKind/updatedAt"
    }
  ],
  "rule_workspace_fields": [
    {
      "field": "ruleSet",
      "behavior": "id/schemaVersion1/name/description/source(system,user,migrated)/readonly/applicability/createdAt/updatedAt/entries"
    },
    {
      "field": "applicability",
      "behavior": "schema支持 all/materialTypes(7 routes)，validate保存强制all+[]"
    },
    {
      "field": "ruleEntry",
      "behavior": "id/pattern/normalizedPattern/entityType/kind/matchMode/enabled/source/createdAt/updatedAt/originWorkspaceId?"
    },
    {
      "field": "kind",
      "behavior": "forceDetect / forceSkip（旧dictionary whitelist在迁移是forceDetect；UI“黑名单”也是forceDetect）"
    },
    {
      "field": "matchMode",
      "behavior": "schema exact/contains，validate与迁移强制exact"
    },
    {
      "field": "source",
      "behavior": "manual/reviewSuggestion/promotedFromWorkspace/excelImport/migration"
    },
    {
      "field": "stored/index",
      "behavior": "{ruleSet,revision>=1}; index schemaVersion1/migrationVersion/activeRuleSetId/ids"
    },
    {
      "field": "correction",
      "behavior": "id/kind/pattern/normalizedPattern/entityType/matchMode/sourceDecisionIds/enabled/risk/createdAt/updatedAt/origin/sourceWorkspaceId?"
    },
    {
      "field": "inheritedPseudonymProfile",
      "behavior": "schemaVersion1/entries(key,token,canonicalKey)/reservedTokens?；entries<=100000/reserved<=200000，keys唯一"
    }
  ],
  "profile_behaviors": [
    "list返回摘要items+preferences；system放在user前；读取用户项会迁移并写回",
    "get返回深拷贝；隐藏system或不在userIds则PROFILE_NOT_FOUND",
    "create(name,description?,baseProfileId?,profile?)：名称trim+不区分大小写唯一，继承默认或指定base；强制id/user/readonly=false/时间/schema",
    "update(profile)：仅user；没有revision参数，不具CAS；保留createdAt、更新updatedAt",
    "duplicate(id,name?)：默认“副本”；同名追加2、3…，再create",
    "delete(id)：系统默认不可删除；其它system逻辑隐藏；user删除items、更新index，若默认则退系统默认",
    "setDefault(id)：必须存在；写preferences；recordSuccessfulExport(kind,state)要求state.kind相同",
    "initialize：错误index退空/坏user记录丢出index/default无效退默认；profile原子文件写rename失败会先rm旧文件再rename，不承诺全局事务"
  ],
  "rule_behaviors": [
    "normalizePattern=trim+全部空白压一个空格；key=entityType+NUL+normalizedPattern+NUL+exact；同kind重复DUPLICATE，异kindCONFLICT",
    "create为空entries、revision1，名称zh-CN小写去边空唯一；description清空/applicability all/exact",
    "update要求revision一致，readonly拒绝；保留id/source/createdAt，revision+1",
    "delete readonly拒绝，active删除退null；setActive(null)允许，system_empty拒绝",
    "list隐藏system_empty；非readonly优先，updatedAt降序；返回enabledDetect/Skip/totalCount/revision/activeId",
    "Excel import仅sheet1；A内容B类型C黑白D状态，旧D匹配列则E状态；返回cleanEntries/conflicts/errors，不持久化；文件内冲突/重复为errors",
    "Excel export两sheet名单/信息、四列、inlineStr；template三列示例及B/C下拉；取消返回success/null",
    "previewPromotion(corrections)只返回accepted/duplicates/conflicts，不持久化，也不把同轮新增项加入查重map",
    "legacy migration完整backup+conflicts；旧whitelist->forceDetect/blacklist->forceSkip，同键保Skip；migrationVersion1，默认不启用",
    "initialize normalizeStored逐表范围all/exact，冲突保Skip，revision+1；单表异常吞掉；create/delete/index跨文件无事务，需要我方安全适配"
  ],
  "workspace_inheritance_behaviors": [
    "selectReviewProfile只选择.tmm；readReviewProfile在授权解锁后抽取继承对象，不直接覆盖工程",
    "先收集继承 reserved tokens 和key->canonicalKey；project mergedInto及每材料pseudonymEntries canonicalKey参与合并",
    "当前文档同canonical组首出现清旧继承同组；selective仅action=pseudonym纳入；locked取currentValue，default取autoValue，其余current||auto",
    "项目sharedMapping仅补未被当前材料覆盖的组；同canonical多值生成multiple-values choices，不能默默选一值",
    "沿用纠正从有效text实体或image active/deleted BBoxes生成，删除->forceSkip，有效->forceDetect；高风险非显式Detect跳过",
    "按 normalizedPattern|entityType 分组；有forceDetect优先于forceSkip；保持sourceDecisionIds、enabled、risk、origin、时间",
    "导入correction同键合并；反向冲突仅在现有决策非显式时允许导入覆盖；输出仅enabled纠正，origin imported/sourceWorkspaceId",
    "readReviewProfile返回filePath/sourceName/sourceWorkspaceId/format/corrections/pseudonyms(schemaVersion1/entries/reservedTokens)/conflicts；它不是普通profile模板"
  ],
  "compatibility_warning": "字段支持与当前发布保存归一化不同；不能按schema已声明就全部启用。未知上层消费、受保护容器、OS对话框、运行边界仍需合法对照；我方独立实现应保留租户授权/CAS/事务而不复刻已知缺陷。"
}
