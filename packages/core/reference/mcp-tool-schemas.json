[
  {
    "name": "resume_lawbot_task",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^lbj_[a-f0-9]{32}$"
        }
      }
    }
  },
  {
    "name": "list_lawbot_saved_settings",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  {
    "name": "start_lawbot_redaction",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_summary": {
          "type": "object",
          "additionalProperties": false,
          "description": "Privacy-safe declared task goals. Supply categories only; NEVER include names, paths, document text, chat titles or user prompt text. This records AI understanding, not user authorization.",
          "properties": {
            "goals": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "contract_review",
                  "document_comparison",
                  "proofreading",
                  "summary",
                  "clause_revision",
                  "relation_extraction",
                  "timeline",
                  "redaction",
                  "restoration",
                  "other"
                ]
              }
            },
            "perspective": {
              "type": "string",
              "enum": [
                "party_a",
                "party_b",
                "neutral"
              ]
            },
            "outputKinds": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "enum": [
                  "redline",
                  "comments",
                  "risk_report",
                  "negotiation_notes",
                  "structured_data",
                  "clean_copy",
                  "summary",
                  "comparison"
                ]
              }
            },
            "outputFormat": {
              "type": "string",
              "enum": [
                "docx",
                "md"
              ]
            },
            "restorationRequested": {
              "type": "boolean"
            }
          }
        },
        "purpose": {
          "type": "string",
          "enum": [
            "contract_review",
            "general_analysis"
          ],
          "default": "contract_review"
        },
        "task_mode": {
          "type": "string",
          "enum": [
            "redact_only",
            "ai_process",
            "ai_process_restore"
          ],
          "default": "ai_process_restore",
          "description": "Infer from user intent: only redact -> redact_only; AI processing without requested restoration -> ai_process; process and restore -> ai_process_restore. Star masks and overlays cannot be restored."
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Cloud compatibility: document:<uploaded document UUID>. Absolute host paths are rejected; upload through the authorized project first."
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "description": "All explicitly supplied input files in one batch call. Never split this array into multiple redaction tasks."
        },
        "document_type": {
          "type": "string",
          "enum": [
            "auto",
            "general",
            "contract",
            "disclosure",
            "judgment",
            "pleading",
            "official_letter",
            "screenshot"
          ],
          "default": "auto"
        },
        "rule_set": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "advanced": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Exact saved Lawbot profile name or ID; unknown profiles fail instead of silently falling back."
            },
            "pseudonymRules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 18,
              "description": "Type-level custom token prefixes or selective pseudonym/mask actions. No original text. Masked categories cannot be restored. Use custom_pseudonym or selective_pseudonym exportMode respectively.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "entityType": {
                    "type": "string",
                    "enum": [
                      "name_cn",
                      "org_name",
                      "id_card",
                      "phone",
                      "bank_card",
                      "address",
                      "email",
                      "website_url",
                      "uscc",
                      "wechat_id",
                      "plate_cn",
                      "securities_account",
                      "case_number",
                      "patent_no",
                      "filing_no",
                      "contract_amount",
                      "seal",
                      "face"
                    ]
                  },
                  "prefix": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "pseudonym",
                      "mask"
                    ]
                  }
                },
                "required": [
                  "entityType"
                ]
              }
            },
            "entityTypes": {
              "type": "array",
              "maxItems": 18,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "name_cn",
                  "org_name",
                  "id_card",
                  "phone",
                  "bank_card",
                  "address",
                  "email",
                  "website_url",
                  "uscc",
                  "wechat_id",
                  "plate_cn",
                  "securities_account",
                  "case_number",
                  "patent_no",
                  "filing_no",
                  "contract_amount",
                  "seal",
                  "face"
                ]
              }
            },
            "exportMode": {
              "type": "string",
              "enum": [
                "default_star",
                "full_star",
                "default_pseudonym",
                "custom_pseudonym",
                "selective_pseudonym"
              ]
            },
            "maskStyle": {
              "type": "string",
              "enum": [
                "black",
                "white",
                "purple",
                "lightGray"
              ]
            },
            "removeImages": {
              "type": "boolean"
            },
            "removeHeaderFooter": {
              "type": "boolean"
            },
            "commentHandlingMode": {
              "type": "string",
              "enum": [
                "remove",
                "anonymize",
                "keep"
              ]
            }
          }
        },
        "masking_mode": {
          "type": "string",
          "enum": [
            "pseudonym",
            "default_mask",
            "full_star",
            "purple_overlay"
          ],
          "default": "pseudonym"
        },
        "output_formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "original",
              "md"
            ]
          },
          "default": [
            "original",
            "md"
          ]
        },
        "unified_pseudonyms": {
          "type": "boolean",
          "default": true,
          "description": "Batch default is true so all outputs and derived reports share one restorable project mapping. Pass false only when the user explicitly requests independent mappings."
        },
        "batch_result_mode": {
          "type": "string",
          "enum": [
            "individual",
            "combined"
          ],
          "default": "individual",
          "description": "Use combined only when the user requests one merged result. It requires unified pseudonyms; the software assembles approved sanitized MD only. Receive the parent artifact once rather than process each child separately."
        },
        "sanitized_output_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Optional ONLY when the user explicitly requested this output folder. Otherwise OMIT; Lawbot uses its software settings. Never choose an AI workspace folder yourself. Requires the user to approve the override in the initial local authorization."
        },
        "restored_output_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Optional ONLY when the user explicitly requested this output folder. Otherwise OMIT; Lawbot uses its software settings. Never choose an AI workspace folder yourself. Requires the user to approve the override in the initial local authorization."
        },
        "file_settings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "description": "Only when the user requests different settings for specific input files. Forward each source_path opaquely; all unspecified settings inherit batch defaults. Never include original text. Unified custom prefixes must be consistent across files.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "document_type": {
                "type": "string",
                "enum": [
                  "auto",
                  "general",
                  "contract",
                  "disclosure",
                  "judgment",
                  "pleading",
                  "official_letter",
                  "screenshot"
                ],
                "default": "auto"
              },
              "rule_set": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "masking_mode": {
                "type": "string",
                "enum": [
                  "pseudonym",
                  "default_mask",
                  "full_star",
                  "purple_overlay"
                ],
                "default": "pseudonym"
              },
              "output_formats": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "original",
                    "md"
                  ]
                },
                "default": [
                  "original",
                  "md"
                ]
              },
              "advanced": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "Exact saved Lawbot profile name or ID; unknown profiles fail instead of silently falling back."
                  },
                  "pseudonymRules": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 18,
                    "description": "Type-level custom token prefixes or selective pseudonym/mask actions. No original text. Masked categories cannot be restored. Use custom_pseudonym or selective_pseudonym exportMode respectively.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "entityType": {
                          "type": "string",
                          "enum": [
                            "name_cn",
                            "org_name",
                            "id_card",
                            "phone",
                            "bank_card",
                            "address",
                            "email",
                            "website_url",
                            "uscc",
                            "wechat_id",
                            "plate_cn",
                            "securities_account",
                            "case_number",
                            "patent_no",
                            "filing_no",
                            "contract_amount",
                            "seal",
                            "face"
                          ]
                        },
                        "prefix": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "pseudonym",
                            "mask"
                          ]
                        }
                      },
                      "required": [
                        "entityType"
                      ]
                    }
                  },
                  "entityTypes": {
                    "type": "array",
                    "maxItems": 18,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "name_cn",
                        "org_name",
