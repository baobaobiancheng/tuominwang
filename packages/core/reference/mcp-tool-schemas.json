                      "lightGray"
                    ]
                  },
                  "removeImages": {
                    "type": "boolean"
                  },
                  "removeHeaderFooter": {
                    "type": "boolean"
                  },
                  "commentHandlingMode": {
                    "type": "string",
                    "enum": [
                      "remove",
                      "anonymize",
                      "keep"
                    ]
                  }
                }
              }
            }
          }
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
