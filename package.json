{
  "name": "tuominwang",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "api": "tsx --env-file=.env apps/api/main.ts",
    "worker": "tsx --env-file=.env apps/worker/main.ts",
    "models:ocr": "tsx scripts/ocr-models.ts",
    "models:ner:source": "tsx scripts/ner-models.ts",
    "test:ner": "tsx scripts/check-ner.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "admin:create": "tsx --env-file=.env scripts/admin.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:integration": "tsx tests/run-isolated.ts integration",
    "test:isolated": "tsx tests/run-isolated.ts integration",
    "test:e2e:isolated": "tsx tests/run-isolated.ts e2e",
    "test:e2e": "tsx tests/run-isolated.ts e2e",
    "bend:build": "tsx scripts/bend.ts build",
    "bend:check": "tsx scripts/bend.ts check",
    "bend:test": "tsx scripts/bend.ts mutations",
    "check": "pnpm bend:check && pnpm bend:test && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@xmldom/xmldom": "0.9.12",
    "bmp-js": "0.1.0",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "drizzle-orm": "0.45.2",
    "entities": "6.0.1",
    "fastify": "5.12.5",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "officecrypto-tool": "0.0.19",
    "onnxruntime-node": "1.30.0",
    "parse5": "7.3.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.4",
    "tesseract.js": "7.0.0",
    "yaml": "2.8.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "docx-preview": "0.3.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
